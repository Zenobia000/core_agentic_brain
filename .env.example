# Core Agentic Brain - 環境變數範例
# 複製此檔案為 .env 並填入你的 API keys
# 注意：不要將 .env 提交到版本控制！

# ===================================
# LLM Provider API Keys
# ===================================

# OpenAI (預設)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini
# GOOGLE_API_KEY=your-google-api-key-here

# Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Ollama (本地模型，不需要 API key)
# 確保 Ollama 服務運行在 http://localhost:11434

# ===================================
# 可選配置
# ===================================

# 日誌設定（可選，有合理預設值）
# LOG_HUMAN=true          # 人類可讀輸出（預設 true）
# LOG_DEBUG=false         # 除錯模式（預設 false）
# LOG_DIR=workspace/logs  # 日誌目錄（預設 workspace/logs）

# 搜尋 API (未來功能)
# TAVILY_API_KEY=your-tavily-api-key-here
# BING_API_KEY=your-bing-api-key-here