          "max_execution_time_ms": 4000
        },
        {
          "id": "tool_003",
          "prompt": "執行這段 Python 代碼並解釋輸出：print([x**2 for x in range(5)])",
          "expected_response_contains": ["0", "1", "4", "9", "16"],
          "expected_tool_calls": ["python"],
          "max_execution_time_ms": 3000
        }
      ]
    },

